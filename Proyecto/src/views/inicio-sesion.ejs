<%- include('partials/header') %>
    <body data-page="inicio-sesion">
        <main class="contenedor">
            <h1>Iniciar Sesion</h1>
        </main>
        <main id="contenedor-inicio" class="iniciar">
            <form id="inicioForm">
                <section class="correo">            
                    <p>Correo: </p>
                    <input type="email" name="" id="initEmail"/>
                </section>
                <section class="contrasena">            
                    <p>Contraseña: </p>
                    <input type="password" name="" id="initPassword"/>
                </section>
                <section class="botones">
                    <button type="submit" id="btnInicio">Iniciar sesion</button>
                    <button type="button" id="btnRegistro">Registrarse</button>
                </section>
            </form>
        </main>
<%- include('partials/footer') %>